{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tern",
  "version": "0.1.2",
  "identifier": "dev.tern.panel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/prepare-agent.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tern",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/tern-agent.exe": "tern-agent.exe"
    }
  }
}
